# === Backend (Maven / Java) ===
target/
*.class
*.jar
*.war
!/.mvn/wrapper/maven-wrapper.jar

# APK/AAB generados (el instalable se genera, no se versiona).
*.apk
*.aab

# === Frontend (Angular / Node) ===
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-error.log*

# === App móvil (Capacitor / Android) ===
# La carpeta android/ SÍ se sube (config del proyecto nativo), pero no sus builds.
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/capacitor-cordova-android-plugins/
# El wrapper de Gradle SÍ debe subirse (la regla *.jar de arriba lo excluiría):
# sin él, un clone no puede compilar el proyecto nativo.
!frontend/android/gradle/wrapper/gradle-wrapper.jar

# === Material subido por el DM en La Mesa (mapas, PDF) ===
data/

# === Secretos de producción (el .example SÍ se sube) ===
.env
!.env.prod.example

# === Herramientas locales de Claude Code ===
.claude/

# === IDE / editores ===
.idea/
.vscode/
*.iml

# === Sistema operativo ===
.DS_Store
Thumbs.db
