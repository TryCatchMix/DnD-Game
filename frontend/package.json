{
  "name": "archivos-frontend",
  "version": "0.1.0",
  "description": "Los Archivos — frontend (Angular 22, standalone, signals, zoneless)",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4300 --proxy-config proxy.conf.json",
    "build": "ng build",
    "check": "ng build --configuration development",
    "cap:sync": "ng build && cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "22.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/cli": "^6.2.1",
    "typescript": "~6.0.0"
  }
}
