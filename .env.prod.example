# Copia este fichero a `.env` en el VPS y rellena los valores reales.
# El .env real NO se sube a git (está en .gitignore).

# Contraseña de PostgreSQL. Pon una larga y aleatoria.
DB_PASSWORD=cambia-esto-por-algo-aleatorio

# Secreto para firmar los JWT. DEBE tener 32 bytes o más.
# Genera uno con:  openssl rand -base64 48
ARCHIVOS_JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-bytes
